From a097d23ee30ee2c52a5940aaa51b19362ad3dd92 Mon Sep 17 00:00:00 2001
From: JoshuaDodds <61622842+JoshuaDodds@users.noreply.github.com>
Date: Thu, 26 Nov 2026 13:09:11 +0000
Subject: [PATCH 5/6] AP_Proximity: LD06: warn if the sensor turns too slowly

A rotation has to fit in the 720 point buffer, which needs at least
6.25Hz (the LD06 default is 10Hz). If the sensor stays slower than that
for 3 seconds send a warning, and repeat it every 30 seconds while it
lasts. Rotations that do not fit are still filtered, in parts.
---
 libraries/AP_Proximity/AP_Proximity_LD06.cpp | 26 ++++++++++++++++++++
 libraries/AP_Proximity/AP_Proximity_LD06.h   |  3 +++
 2 files changed, 29 insertions(+)

diff --git a/libraries/AP_Proximity/AP_Proximity_LD06.cpp b/libraries/AP_Proximity/AP_Proximity_LD06.cpp
index 0c697994f0..b3ddf34c08 100644
--- a/libraries/AP_Proximity/AP_Proximity_LD06.cpp
+++ b/libraries/AP_Proximity/AP_Proximity_LD06.cpp
@@ -27,6 +27,7 @@
 
 #if AP_PROXIMITY_LD06_ENABLED
 #include "AP_Proximity_LD06.h"
+#include <GCS_MAVLink/GCS.h>
 
 #define LD_START_CHAR       0x54
 #define PROXIMITY_LD06_TIMEOUT_MS 50
@@ -58,6 +59,10 @@
 #define LD06_FILTER_CONFIRM_DEG         4       // within this many degrees
 #define LD06_FILTER_CONFIRM_MIN_MM      300     // and within 10% or this distance, whichever is larger
 #define LD06_SWEEP_UNSEEN               UINT16_MAX
+// below this rotation speed a rotation does not fit in _scan (6.25Hz)
+#define LD06_MIN_SPEED_DPS              (LD06_FILTER_POINTS_PER_SEC * 360.0f / LD06_ROTATION_POINTS_MAX)
+#define LD06_SLOW_WARN_AFTER_MS         3000    // warn when it has turned too slowly for this long (not at spin-up)
+#define LD06_SLOW_WARN_EVERY_MS         30000   // and repeat while it lasts
 
  /* ------------------------------------------
     Data Packet Structure:
@@ -200,6 +205,7 @@ void AP_Proximity_LD06::parse_response_data()
     if (speed_dps > 0) {
         _scan_speed_dps = speed_dps;
     }
+    check_rotation_speed(speed_dps);
 
     // Each recording point is three bytes long, goes through all of that and updates database
     for (uint16_t i = START_PAYLOAD; i < START_PAYLOAD + MEASUREMENT_PAYLOAD_LENGTH * PAYLOAD_COUNT; i += MEASUREMENT_PAYLOAD_LENGTH) {
@@ -218,6 +224,26 @@ void AP_Proximity_LD06::parse_response_data()
     }
 }
 
+// warn if the sensor keeps turning too slowly for a rotation to fit in _scan
+void AP_Proximity_LD06::check_rotation_speed(uint16_t speed_dps)
+{
+    const uint32_t now_ms = AP_HAL::millis();
+    if (speed_dps >= LD06_MIN_SPEED_DPS) {
+        _slow_since_ms = 0;
+        return;
+    }
+    if (_slow_since_ms == 0) {
+        _slow_since_ms = now_ms;
+        return;
+    }
+    if (now_ms - _slow_since_ms > LD06_SLOW_WARN_AFTER_MS &&
+        (_slow_warn_ms == 0 || now_ms - _slow_warn_ms > LD06_SLOW_WARN_EVERY_MS)) {
+        _slow_warn_ms = now_ms;
+        GCS_SEND_TEXT(MAV_SEVERITY_WARNING, "PRX%u: LD06 turning too slowly (%u deg/s)",
+                      unsigned(state.instance + 1), unsigned(speed_dps));
+    }
+}
+
 // filter the buffered rotation and pass the points that survive to the sectors and faces
 void AP_Proximity_LD06::process_rotation()
 {
diff --git a/libraries/AP_Proximity/AP_Proximity_LD06.h b/libraries/AP_Proximity/AP_Proximity_LD06.h
index 5717ed12d4..4864059d60 100644
--- a/libraries/AP_Proximity/AP_Proximity_LD06.h
+++ b/libraries/AP_Proximity/AP_Proximity_LD06.h
@@ -93,12 +93,15 @@ private:
 
     // filter the buffered rotation and pass the surviving points on
     void process_rotation();
+    void check_rotation_speed(uint16_t speed_dps);
     static void set_group_keep(ScanPoint *points, uint16_t first, uint16_t last, uint16_t size, bool keep);
 
     ScanPoint _scan[LD06_ROTATION_POINTS_MAX];  // current rotation
     uint16_t _scan_count;                       // number of points in _scan
     uint16_t _scan_speed_dps;                   // latest non-zero rotation speed
     float _last_start_angle_deg;                // start angle of the previous packet
+    uint32_t _slow_since_ms;                    // sensor turning too slowly since (0 = it is not)
+    uint32_t _slow_warn_ms;                     // last "turning too slowly" warning
     uint16_t _last_sweep_mm[LD06_SWEEP_BINS];   // nearest kept point per degree, previous sweep
     uint16_t _sweep_scratch_mm[LD06_SWEEP_BINS];
 
